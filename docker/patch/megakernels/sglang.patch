+++ b/test/registered/unit/megakernels/test_megakernel_binding.py
@@ -0,0 +1,139 @@
+"""CPU checks of the megakernel binding: the view is the running forward's attention
+backend and KV pool, and a source replaced after capture is caught."""
+
+import unittest
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import torch
+
+from sglang.srt.megakernels import binding as mb
+from sglang.test.ci.ci_register import register_cpu_ci
+from sglang.test.test_utils import CustomTestCase
+
+register_cpu_ci(est_time=5, stage="base-a", runner_config="cpu")
+
+BACKEND = "sglang.srt.model_executor.forward_context.get_attn_backend"
+
+
+class Pool:
+    uniform_fp8 = False
+    request_window = None
+
+    def __init__(self):
+        self.keys = [torch.zeros(4, 8) for _ in range(2)]
+
+    def get_swa_key_buffer_radix(self, layer_id):
+        return self.keys[layer_id]
+
+    def get_extra_key_page_size(self, layer_id):
+        return 64 + layer_id
+
+    def set_swa_key_buffer_radix_fused_norm_rope(self, **kw):
+        return kw
+
+
+def backend(pool):
+    return SimpleNamespace(
+        token_to_kv_pool=pool,
+        forward_metadata=SimpleNamespace(core_attn_metadata="core"),
+        trtllm_attn=False,
+        forward=lambda *a, **k: "attention",
+        store_cache=lambda **k: None,
+        get_swa_out_cache_loc=lambda fb: "swa_loc",
+        forward_low_ratio_sources=lambda **k: "sources",
+        forward_core_compressor=lambda **k: "compressed",
+    )
+
+
+class TestMegakernelBinding(CustomTestCase):
+    def test_the_view_is_the_running_forwards_backend_and_pool(self):
+        pool = Pool()
+        with patch(BACKEND, return_value=backend(pool)):
+            view = mb.MegakernelBinding(model=torch.nn.Module()).forward_view()
+        self.assertEqual(view.metadata.core_attn_metadata, "core")
+        self.assertIs(view.kv_pool.pool, pool)
+        self.assertIs(view.kv_pool.get_swa_key_buffer_radix(1), pool.keys[1])
+
+    def test_a_replaced_source_fails_assert_live_by_name(self):
+        model = torch.nn.Module()
+        model.engram_hasher = SimpleNamespace(history=torch.zeros(5, 3))
+        binding = mb.MegakernelBinding(model=model)
+        attn_backend = backend(Pool())
+        with patch(BACKEND, return_value=attn_backend):
+            binding.forward_view()
+            self.assertIs(binding.engram_history(), model.engram_hasher.history)
+            binding.assert_live()
+            model.engram_hasher.history = torch.zeros(9, 3)
+            with self.assertRaisesRegex(RuntimeError, "engram_history"):
+                binding.assert_live()
+        binding = mb.MegakernelBinding(model=torch.nn.Module())
+        with patch(BACKEND, return_value=backend(Pool())):
+            binding.forward_view()
+        with patch(BACKEND, return_value=backend(Pool())):
+            with self.assertRaisesRegex(RuntimeError, "kv_pool"):
+                binding.assert_live()
+
+    def test_a_hybrid_view_reads_both_sides_and_tracks_every_linear_layer(self):
+        kv_pool, state_pool = Pool(), StatePool(layer_ids=(0, 1, 2, 4, 5, 6))
+        hybrid = hybrid_backend(kv_pool, state_pool)
+        with patch(BACKEND, return_value=hybrid):
+            binding = mb.MegakernelBinding(model=torch.nn.Module())
+            view = binding.forward_view()
+        # the full-attention side's metadata and KV pool, the linear side's state
+        self.assertEqual(view.metadata.core_attn_metadata, "core")
+        self.assertIs(view.kv_pool.pool, kv_pool)
+        self.assertIs(view.req_to_token, hybrid.req_to_token_pool.req_to_token)
+        self.assertEqual(view.linear.layer_ids, [0, 1, 2, 4, 5, 6])
+        self.assertIs(view.linear.layer_cache(4).temporal, state_pool.caches[4].temporal)
+        view.linear.track_states("batch")
+        tracked = hybrid.linear_attn_backend.tracked
+        self.assertEqual([layer for *_, layer in tracked], [0, 1, 2, 4, 5, 6])
+        self.assertTrue(all(fb == "batch" for fb, *_ in tracked))
+        # a reallocated state pool is caught like a reallocated KV pool
+        with patch(BACKEND, return_value=hybrid):
+            binding.assert_live()
+        hybrid.linear_attn_backend.req_to_token_pool = StatePool(layer_ids=(0,))
+        with patch(BACKEND, return_value=hybrid):
+            with self.assertRaisesRegex(RuntimeError, "linear_state_pool"):
+                binding.assert_live()
+
+    def test_a_model_without_linear_attention_has_no_linear_view(self):
+        with patch(BACKEND, return_value=backend(Pool())):
+            view = mb.MegakernelBinding(model=torch.nn.Module()).forward_view()
+        self.assertIsNone(view.linear)
+
+
+class StatePool:
+    def __init__(self, layer_ids):
+        self.mamba_map = {layer: i for i, layer in enumerate(layer_ids)}
+        self.caches = {
+            layer: SimpleNamespace(conv=[torch.zeros(3, 2)], temporal=torch.zeros(3, 4))
+            for layer in layer_ids
+        }
+
+    def mamba2_layer_cache(self, layer_id):
+        return self.caches[layer_id]
+
+
+class LinearBackend:
+    def __init__(self, state_pool):
+        self.req_to_token_pool = state_pool
+        self.forward_metadata = SimpleNamespace(mamba_cache_indices=torch.arange(3))
+        self.tracked = []
+
+    def _track_mamba_state_decode(self, forward_batch, conv, ssm, indices, layer_id):
+        self.tracked.append((forward_batch, conv, ssm, indices, layer_id))
+
+
+def hybrid_backend(kv_pool, state_pool):
+    return SimpleNamespace(
+        token_to_kv_pool=kv_pool,
+        req_to_token_pool=SimpleNamespace(req_to_token=torch.zeros(2, 8)),
+        full_attn_backend=backend(kv_pool),
+        linear_attn_backend=LinearBackend(state_pool),
+    )
+
+
+if __name__ == "__main__":
+    unittest.main()
