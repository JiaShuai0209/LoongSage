+"""CPU checks of --enable-nvidia-megakernel's startup resolution."""
+
+import sys
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+from sglang.srt.megakernels import guards, runtime
+from sglang.srt.megakernels import spec as registry
+from sglang.srt.megakernels.guards import megakernel_disable_reasons
+from sglang.test.ci.ci_register import register_cpu_ci
+from sglang.test.test_utils import CustomTestCase
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from _fakes import ARCH, ISA, server_args  # noqa: E402
+
+register_cpu_ci(est_time=5, stage="base-a", runner_config="cpu")
+
+
+class TestMegakernelGuards(CustomTestCase):
+    def setUp(self):
+        registry_patch = patch.dict(registry._REGISTRY, clear=True)
+        registry_patch.start()
+        self.addCleanup(registry_patch.stop)
+
+    def test_a_disabled_flag_looks_nothing_up_and_keeps_the_forward(self):
+        with patch.object(guards, "megakernel_disable_reasons") as lookup:
+            guards.handle_nvidia_megakernel(server_args())
+        lookup.assert_not_called()
+        model = SimpleNamespace()  # any attribute read would raise
+        with patch.object(runtime, "megakernel_enabled", return_value=False):
+            runtime.install_megakernel(
+                model=model, hf_config=None, capture_tail_hooks=[], is_draft=False
+            )
+        self.assertEqual(vars(model), {})
+
+    def test_an_enabled_flag_loads_the_plugins_before_the_lookup(self):
+        """http_server.launch_server resolves the arguments before it loads plugins."""
+        calls = []
+        with patch("sglang.srt.plugins.load_plugins", lambda: calls.append("load")), \
+                patch.object(guards, "model_config_of"), \
+                patch.object(guards, "megakernel_disable_reasons",
+                             side_effect=lambda **kw: calls.append("lookup") or (None, ["x"])), \
+                self.assertRaises(ValueError):
+            guards.handle_nvidia_megakernel(server_args(enable_nvidia_megakernel=True))
+        self.assertEqual(calls, ["load", "lookup"])
+
+    def _reasons(self, path, **kw):
+        registry._REGISTRY.clear()
+        if path is not None:
+            registry.register(architecture=ARCH, path=path)
+        hf_config = SimpleNamespace(architectures=[ARCH], model_type="fake")
+        _, reasons = megakernel_disable_reasons(
+            cfg=server_args(**kw), hf_config=hf_config, isa=ISA
+        )
+        return reasons
+
+    def test_an_unmet_tp_size_is_refused_and_an_empty_field_accepts_any(self):
+        def tp_reasons(path):
+            return [r for r in self._reasons(path, tp_size=8) if "tp_size" in r]
+
+        self.assertTrue(tp_reasons("_fakes:SPEC"))
+        self.assertEqual(tp_reasons("_fakes:ANY_TP"), [])
+
+    def test_any_plugin_may_register_and_none_registered_is_named(self):
+        """No entry point name is required: a spec from any plugin is used."""
+        self.assertEqual(self._reasons("_fakes:SPEC"), [])
+        (reason,) = self._reasons(None)
+        self.assertIn("no sglang.srt.plugins plugin registered", reason)
+
+    def test_the_decode_attention_backend_must_be_one_the_spec_reads(self):
+        def backend_reasons(**kw):
+            return [r for r in self._reasons("_fakes:FA3_ONLY", **kw) if "attention" in r]
+
+        self.assertEqual(backend_reasons(attention_backend="fa3"), [])
+        # the decode-phase backend is the one checked
+        self.assertEqual(
+            backend_reasons(attention_backend="triton", decode_attention_backend="fa3"),
+            [],
+        )
+        self.assertTrue(backend_reasons(attention_backend="triton"))
+
+    def test_linear_replayssm_is_refused_unless_accepted(self):
+        reasons = self._reasons("_fakes:SPEC", enable_linear_replayssm=True)
+        self.assertTrue(any("--enable-linear-replayssm" in r for r in reasons))
+
+
+if __name__ == "__main__":
+    unittest.main()
